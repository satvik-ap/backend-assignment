// Question 1: Coding Assessment
function codingScoreCheck(marks, cutoff) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            let total = 0;
            for (let mark of marks) {
                total += mark;
            }
            let average = total / marks.length;

            if (average >= cutoff) {
                resolve(average);
            } else {
                reject("Sorry, you have not cleared the Coding Assessment.");
            }
        }, 2000);
    });
}

// Question 2: Technical Interview
function technicalInterviewCheck(marks, cutoff) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            let total = 0;
            for (let mark of marks) {
                total += mark;
            }
            let average = total / marks.length;

            if (average >= cutoff) {
                resolve(average);
            } else {
                reject("Sorry, you have not cleared the Technical Interview.");
            }
        }, 2000);
    });
}

// Question 3: Final Selection Review
function finalSelectionCheck(codingAverage, technicalAverage, cutoff) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            let finalAverage = (codingAverage + technicalAverage) / 2;

            if (finalAverage >= cutoff) {
                resolve(finalAverage);
            } else {
                reject("Sorry, you have not cleared the final selection cutoff.");
            }
        }, 2000);
    });
}

// Start the recruitment process
let codingAvg;

codingScoreCheck([80, 75, 90], 70)
    .then(coding => {
        console.log("Coding Passed:", coding);
        codingAvg = coding;
        return technicalInterviewCheck([75, 80, 85], 70);
    })
    .then(interview => {
        console.log("Interview Passed:", interview);
        return finalSelectionCheck(codingAvg, interview, 70);
    })
    .then(final => {
        console.log("Final Selection Passed:", final);
        console.log("Congratulations! You are selected.");
    })
    .catch(error => {
        console.log(error);
    });